# Copy to .env; never commit .env or real credentials.
# One KEY=value per line. Double-quoted JSON strings are also accepted.
WIFI_SSID=YOUR_2_4_GHZ_WIFI
WIFI_PASSWORD=YOUR_WIFI_PASSWORD

# STT key: https://bailian.console.aliyun.com/cn-beijing/model/settings/api-key
# Beijing endpoint template. Replace {WorkspaceId} with your console Workspace ID
# (including its ws- prefix), not your API key. Keep the /chat/completions suffix.
STT_API_URL=https://{WorkspaceId}.cn-beijing.maas.aliyuncs.com/compatible-mode/v1/chat/completions
STT_API_KEY=
STT_MODEL=qwen3-asr-flash
# LLM key: https://platform.kimi.com/console/api-keys
LLM_API_URL=https://api.moonshot.cn/v1/chat/completions
LLM_API_KEY=
LLM_MODEL=kimi-k2.6
# TTS key: https://console.volcengine.com/speech/new (speech service, X-Api-Key auth).
# Enable seed-tts-2.0. Voice must also match assets/wake_ack/manifest.json.
TTS_API_URL=https://openspeech.bytedance.com/api/v3/tts/unidirectional
TTS_API_KEY=
TTS_RESOURCE_ID=seed-tts-2.0
TTS_SPEAKER=zh_female_qingchezizi_uranus_bigtts
